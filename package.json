{
  "name": "prism",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=20.20.0"
  },
  "scripts": {
    "dev": "pnpm --filter @prism/web dev",
    "build": "turbo build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node --import tsx scripts/check-architecture.ts",
    "test": "vitest run tests/unit",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "test:integration": "vitest run tests/integration",
    "evaluate": "node --import tsx scripts/evaluate.ts",
    "prism": "node --import tsx apps/cli/src/index.ts",
    "test:e2e": "playwright test",
    "dev:services": "turbo dev --filter=@prism/github-app --filter=@prism/worker",
    "dev:demo": "PRISM_DEMO=true pnpm --filter @prism/web dev",
    "format:web": "prettier --write apps/web/src packages/ui/src",
    "format:check": "prettier --check apps/web/src packages/ui/src"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.5",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "type": "module"
}
