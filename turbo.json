{
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ],
      "env": [
        "PRISM_DEMO",
        "DATABASE_URL",
        "NEXT_PUBLIC_APP_URL",
        "GITHUB_APP_SLUG"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalDependencies": [
    "packages/**/src/**",
    "evaluation/cases/**",
    "scripts/load-env.mjs",
    "tsconfig.json"
  ]
}
