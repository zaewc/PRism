    "@prism/config": "workspace:*",
    "@prism/policy": "workspace:*",
    "bullmq": "6.3.11",
    "ioredis": "6.0.0",
    "fastify": "5.12.5",
    "@fastify/rate-limit": "11.2.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "tsx": "4.23.15"
