{
  "name": "@prism/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --platform node"
  },
  "dependencies": {
    "@prism/domain": "workspace:*",
    "@prism/github": "workspace:*",
    "@prism/judge": "workspace:*",
    "@prism/database": "workspace:*",
    "@prism/application": "workspace:*",
    "@prism/observability": "workspace:*",
    "@prism/config": "workspace:*",
    "@prism/policy": "workspace:*",
    "bullmq": "6.3.11",
    "ioredis": "6.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "tsx": "4.23.15"
  }
}
