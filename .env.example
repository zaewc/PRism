# Copy to .env. This file contains no credentials.
NODE_ENV=development
DATABASE_URL=postgresql://prism:prism_local@localhost:5434/prism
REDIS_URL=redis://localhost:6381
WEBHOOK_PORT=3001
APP_URL=http://localhost:3000
# Dashboard is a single-installation/operator service. Set a long password before exposing it.
PRISM_ADMIN_USER=operator
PRISM_ADMIN_PASSWORD=
PRISM_DEMO=false
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
GITHUB_CODE_SCANNING=false
JEV_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_MS=15000
WORKER_CONCURRENCY=2
# Optional OTLP HTTP collector, e.g. http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=prism
